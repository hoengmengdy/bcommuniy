# Local Docker Compose only. Copy to .env.production; never commit secrets.
# Generate EACH secret separately with: py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-different-random-hex-secret
POSTGRES_USER=bcommunity
POSTGRES_DB=bcommunity
TOKEN_MAX_AGE=86400
# Render generates/injects SECRET_KEY, DATABASE_URL, and RATELIMIT_STORAGE_URI.
# APP_ENV=production
# DATABASE_URL=postgresql://user:password@private-host:5432/bcommunity
# RATELIMIT_STORAGE_URI=redis://private-redis-host:6379
# TRUST_PROXY=1  # Only behind Render's trusted proxy.
