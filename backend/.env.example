# Missing .env is created automatically with a random secret on first start.
# If copying this file, replace SECRET_KEY before starting.
# Generate one: py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
# Leave DATABASE_URL unset for backend/database/app.db.
# DATABASE_URL=postgresql+psycopg://user:password@localhost/bcommunity
# DATABASE_URL=mysql+pymysql://user:password@localhost/bcommunity
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TOKEN_MAX_AGE=86400
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
# Optional first administrator, created with: python app.py create-admin
# ADMIN_EMAIL=you@example.com
# ADMIN_NAME=Community Administrator
# ADMIN_PASSWORD=
